# ============================================================
# Treclone - Environment Configuration
#
# The defaults below match the local Docker setup
# (see docker-compose.yml).
# ============================================================

# ---------- Database (PostgreSQL via Prisma) ----------
DATABASE_URL="postgresql://treclone:treclone123@localhost:5432/treclone"

# ---------- Auth ----------
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-hex-string"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------- Email ----------
# Option A - Local development with Mailpit (docker-compose).
# Emails are shown in the UI at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="Treclone <noreply@localhost>"

# Option B - Production with Resend (comment out the SMTP_* block above and use):
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Treclone <noreply@your-domain.com>"
