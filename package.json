{
  "name": "treclone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "rimraf .next && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:build": "docker build -f docker/dev.Dockerfile -t treclone:dev .",
    "docker:build:prod": "docker build -f docker/prod.Dockerfile -t treclone:prod .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@react-oauth/google": "^0.13.5",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.99.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.6",
    "lucide-react": "^1.8.0",
    "next": "15.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.5",
    "pg": "8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "shadcn": "^4.4.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/eslint": "^8.56.10",
    "@types/lru-cache": "^7.10.9",
    "@types/node": "22.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "eslint-config-next": "15.3.8",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.0",
    "postcss": "8.5.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "prisma": "^7.8.0",
    "rimraf": "^5.0.7",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.8.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "import-in-the-middle": "3.0.1"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "@sentry/cli@2.58.5": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "msw@2.13.4": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.11.1": true
  }
}
