# Set default line endings
* text=auto

# Force LF line endings for these file types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Mark as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary

# Prisma files
*.prisma text

# Docker files
docker/* text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# GitHub workflows
.github/** text eol=lf

# Diff
*.diff text -diff
*.patch text -diff
